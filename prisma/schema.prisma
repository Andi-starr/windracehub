generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  passwordHash String?
  role         UserRole    @default(PARTICIPANT)
  locale       String      @default("de")
  createdAt    DateTime    @default(now())
  lastActiveAt DateTime    @default(now())
  warned7At    DateTime?
  warned1At    DateTime?
  crew         CrewMember[]
  pwTokens     PasswordToken[]
  sessions     Session[]
  roles        EventRole[]
  boats        Boat[]
  entries      Entry[]
}

enum UserRole {
  ADMIN
  HOST
  PARTICIPANT
}

/// A participant's boat, used to prefill registrations.
model Boat {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  className  String
  sailNumber String
  boatName   String?
  crew       String?
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}

model Club {
  id        String  @id @default(cuid())
  name      String  @unique
  shortName String?
  website   String?
  events    Event[]
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

model Event {
  id           String         @id @default(cuid())
  slug         String         @unique
  title        String
  clubId       String?
  club         Club?          @relation(fields: [clubId], references: [id])
  venue        String?
  startDate    DateTime       @db.Date
  endDate      DateTime       @db.Date
  description  String?
  entryInfo    String?
  entryUrl     String?
  contactEmail String?
  status       EventStatus    @default(DRAFT)
  entriesOpen  Boolean        @default(true)
  entriesCloseAt DateTime?    // Meldeschluss: online entry closes automatically after this
  discards     String?        // e.g. "4:1,8:2" = 1 discard from 4 races, 2 from 8
  sourceUrl    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  classes      EventClass[]
  schedule     ScheduleItem[]
  documents    Document[]
  results      Result[]
  entries      Entry[]
  roles        EventRole[]
  invites      Invite[]
  races        Race[]

  @@index([startDate])
}

model EventClass {
  id       String   @id @default(cuid())
  eventId  String
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name     String
  position Int      @default(0)
  results  Result[]
  entries  Entry[]
  races    Race[]
}

model ScheduleItem {
  id      String   @id @default(cuid())
  eventId String
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  at      DateTime
  title   String
}

enum DocType {
  NOR
  SCHEDULE
  SI
  AMENDMENT
  NOTICE
  PROTEST
  OTHER
}

model Document {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type         DocType
  title        String
  fileKey      String
  fileName     String
  size         Int
  publishedAt  DateTime @default(now())
  uploadedBy   String?
}

model Result {
  id           String      @id @default(cuid())
  eventId      String
  event        Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  classId      String?
  eventClass   EventClass? @relation(fields: [classId], references: [id], onDelete: SetNull)
  title        String
  provisional  Boolean     @default(true)
  headers      String[]
  rows         Json?
  fileKey      String?
  fileName     String?
  publishedAt  DateTime    @default(now())
  uploadedBy   String?
}

model Entry {
  id         String      @id @default(cuid())
  eventId    String
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  classId    String?
  eventClass EventClass? @relation(fields: [classId], references: [id], onDelete: SetNull)
  sailNumber String?
  boatName   String?
  skipper    String?
  club       String?
  crew       String?
  handicap   Float?   // yardstick number, optional
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  finishes   Finish[]
}

enum RaceStatus {
  PLANNED
  SEQUENCE
  RUNNING
  FINISHED
  ABANDONED
}

model Race {
  id         String      @id @default(cuid())
  eventId    String
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  classId    String?
  eventClass EventClass? @relation(fields: [classId], references: [id], onDelete: SetNull)
  number     Int
  status     RaceStatus  @default(PLANNED)
  /// minutes before start for each signal, e.g. "5,4,1,0"
  sequence   String      @default("5,4,1,0")
  prepFlag   String      @default("P")
  startAt    DateTime?
  note       String?
  updatedAt  DateTime    @updatedAt
  finishes   Finish[]

  @@unique([eventId, classId, number])
}

model Finish {
  id         String    @id @default(cuid())
  raceId     String
  race       Race      @relation(fields: [raceId], references: [id], onDelete: Cascade)
  entryId    String
  entry      Entry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  finishedAt DateTime?
  position   Int?
  code       String?   // DNF DNS DNC OCS RET DSQ BFD UFD

  @@unique([raceId, entryId])
}

enum Role {
  HOST
  OFFICIAL
  HELPER // e.g. a participant account helping at the start/finish: race clock + finishes only
}

model EventRole {
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  role    Role

  @@id([userId, eventId])
}

model Invite {
  token      String    @id
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  email      String
  role       Role
  createdAt  DateTime  @default(now())
  acceptedAt DateTime?
}

/// Saved crew members of a participant, ticked when entering an event.
model CrewMember {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  club   String?
}

/// One-time link to set a password (admin-created hosts, password reset).
model PasswordToken {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}
