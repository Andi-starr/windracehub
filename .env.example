# Supabase > Project settings > Database > Connection string
# Pooled (port 6543, add ?pgbouncer=true) for the app, direct (port 5432) for migrations
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
# Long random string (e.g. `openssl rand -hex 32`)
SESSION_SECRET=""
# Supabase > Project settings > API. Leave empty to store uploads in ./uploads (local dev only)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="files"
# Public base URL, used in invite links
APP_URL="https://windracehub.com"
# Email (Resend.com, free tier): host-login links and the inactivity notices.
# Without these, links are shown in the admin page and automatic deletion stays off.
RESEND_API_KEY=""
MAIL_FROM="windracehub <noreply@windracehub.com>"
# Protects the daily cleanup job (/api/cron/cleanup); Vercel sends it automatically. Any long random string.
CRON_SECRET=""

# Claude (Dokument-Entwürfe). Key von console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: Adresse für "Regatta veranstalten → Zugang anfragen"
CONTACT_EMAIL=

# TEMPORARY: purple "view as Admin/Host/Participant" bar for the admin. Set to off (or delete the code) before launch.
ROLE_SWITCHER=on
