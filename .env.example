# Supabase > Project settings > Database > Connection string
# Pooled (port 6543, add ?pgbouncer=true) for the app, direct (port 5432) for migrations
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
# Long random string (e.g. `openssl rand -hex 32`)
SESSION_SECRET=""
# Supabase > Project settings > API. Leave empty to store uploads in ./uploads (local dev only)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="files"
# Public base URL, used in invite links
APP_URL="https://windracehub.com"
